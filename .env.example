# Copy to backend/.env for local development. Never commit the real file.

# Django
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# HERE (routing + geocoding). Server-side only; never exposed to the browser.
HERE_API_KEY=

# Provider cache: "sqlite" (default; a file that survives restarts and is shared by workers)
# or "locmem" (in-process memory). CACHE_DB moves the SQLite file.
# CACHE_BACKEND=sqlite
# CACHE_DB=cache.sqlite3

# Abuse protection (backend/routing/limits.py). Defaults shown.
# HERE requests allowed per UTC day, from all visitors together.
# HERE_DAILY_CAP=300
# Per-IP rates: "<count>/<second|minute|hour|day>".
# THROTTLE_PLAN_MINUTE=10/minute
# THROTTLE_PLAN_DAY=100/day
# THROTTLE_GEOCODE_MINUTE=60/minute
# Proxies in front of the app (1 = Azure's ingress; 0 = none). Finds the client IP.
# NUM_PROXIES=1
