# Copy to backend/.env for local development. Never commit the real file.

# Django
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# HERE (routing + geocoding). Server-side only; never exposed to the browser.
HERE_API_KEY=

# Optional paid Open-Meteo key (commercial use / higher limits). Leave empty for the free API.
OPEN_METEO_API_KEY=
